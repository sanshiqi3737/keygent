# 阿里云百炼（DashScope）— 智能练习建议
# 复制为 .env 或在本机环境变量中设置；切勿提交真实 Key
# Beta 发给用户且不想让用户填 Key：见 desktop/publisher.env.example（打包时打入 publisher-bundled.env）
DASHSCOPE_API_KEY=sk-your-key-here
# 可选：qwen-turbo | qwen-plus | qwen-max
DASHSCOPE_MODEL=qwen-turbo
# 一般无需修改（OpenAI 兼容模式北京地域）
# DASHSCOPE_COMPAT_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 性能（云端小机器建议）---
# 上传曲谱时跳过百炼 LLM 微调难度（仍保留规则评估），显著加快 /api/score/upload
# PIANO_UPLOAD_ASSESSMENT_LLM=false
# 音频转录 librosa.pyin：hop 越大越快、略损精度；可试 384 或 512
# PIANO_TRANSCRIBE_HOP_LENGTH=384
